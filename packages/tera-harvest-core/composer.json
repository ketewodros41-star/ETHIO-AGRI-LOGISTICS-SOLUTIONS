{
    "name": "fleetbase/tera-harvest-core",
    "type": "library",
    "description": "Tera Harvest — Ethiopian Agricultural Supply Chain Platform, built on Fleetbase",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Tera Harvest",
            "email": "dev@teraharvest.et"
        }
    ],
    "require": {
        "php": ">=8.0 <=8.2.30",
        "laravel/framework": "^10.0",
        "fleetbase/core-api": "^1.6",
        "barryvdh/laravel-dompdf": "^2.0",
        "bacon/bacon-qr-code": "^2.0",
        "simplesoftwareio/simple-qrcode": "^4.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0",
        "fakerphp/faker": "^1.9"
    },
    "autoload": {
        "psr-4": {
            "Fleetbase\\TeraHarvest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fleetbase\\TeraHarvest\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fleetbase\\TeraHarvest\\Providers\\TeraHarvestServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
