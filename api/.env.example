APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ─── Tera Harvest ────────────────────────────────────────────────────────────
TERA_HARVEST_AI_URL=http://ai-service:8000
ECX_PRICES_URL=

# Africa's Talking (SMS/USSD)
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=TeraHarvest
AT_USSD_CODE=

# Chapa (primary payment gateway)
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Telebirr
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_BASE_URL=

# CBE Birr
CBE_BIRR_MERCHANT_ID=
CBE_BIRR_API_KEY=
CBE_BIRR_BASE_URL=

# Certificate / Compliance document storage
CERTIFICATE_DISK=s3
COMPLIANCE_DISK=s3

# Langfuse (AI observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Phase 2 additions ────────────────────────────────────────────────────────

# Carbon Tracking (IPCC 2006)
CARBON_BENCHMARK_KG=

# Driver Earnings
DRIVER_BASE_RATE_ETB=85.00
DRIVER_VOLUME_BONUS_ETB=500.00

# Aggregation
AGGREGATION_COMMISSION_PCT=3.5

# Forward Contracts
CONTRACT_DEPOSIT_PCT=10.00

# Input Supply
INPUT_DELIVERY_FEE_ETB=50.00

# ECX Prices API
ECX_PRICES_URL=

# Tera Harvest internal API URL (used by ai-service tools to call back Laravel)
TERA_HARVEST_API_URL=http://api:8000
